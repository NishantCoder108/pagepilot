# Frontend build-time configuration, embedded in the public JavaScript bundle.
# Leave empty for Vite proxy or combined local hosting.
# In Vercel, set the exact HTTPS origin of your backend (no /api).
# The API client uses this setting. Keep it consistent with vercel.json's CSP.
VITE_API_BASE_URL=
# Never put provider API keys in a VITE_ variable. Users enter them in the UI.
