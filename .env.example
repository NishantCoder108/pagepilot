# Environment variables are read by Rust; export them in your shell or set them
# through Compose. The application intentionally does not load a .env file.
# Never put provider keys here. Enter them through the browser UI.
BIND_ADDR=127.0.0.1:3000
WEB_DIR=web/dist
# Combined local/container hosting defaults to true; set false for the HF API.
SERVE_FRONTEND=true
# Comma-separated exact frontend origins. Empty preserves same-origin use.
# For split hosting, set your actual HTTPS Vercel URL; wildcards are rejected.
ALLOWED_ORIGINS=
# Limits below apply to ONE running server instance, not individual users.
# They control separate stages and should not be added into a user capacity.
# URL extraction jobs (download through HTML parsing). Excess work gets 503.
FETCH_CONCURRENCY=16
# CPU-bound HTML parsing workers; a full parsing pool returns 503.
PARSE_CONCURRENCY=2
# Active AI requests/streams, released on completion, cancellation, or timeout.
GENERATION_CONCURRENCY=16
# Requests reading bodies/preparing responses; excludes streams after setup.
REQUEST_CONCURRENCY=64
# Deadlines in seconds for request setup, downloads, and AI streams.
REQUEST_TIMEOUT_SECONDS=30
FETCH_TIMEOUT_SECONDS=20
GENERATION_TIMEOUT_SECONDS=120
MAX_DOWNLOAD_BYTES=2000000
MAX_DOCUMENT_BYTES=200000
MAX_REQUEST_BYTES=1000000
# Separate rate limit: POSTs per immediate peer IP in a 60-second window (429).
# Behind a reverse proxy, visitors may share this quota; configure edge limits.
REQUESTS_PER_MINUTE=30
