# Environment variables are read by Rust; export them in your shell or set them
# through Compose. The application intentionally does not load a .env file.
# Never put provider keys here. Enter them through the browser UI.
BIND_ADDR=127.0.0.1:3000
WEB_DIR=web/dist
FETCH_CONCURRENCY=16
PARSE_CONCURRENCY=2
GENERATION_CONCURRENCY=16
REQUEST_CONCURRENCY=64
REQUEST_TIMEOUT_SECONDS=30
FETCH_TIMEOUT_SECONDS=20
GENERATION_TIMEOUT_SECONDS=120
MAX_DOWNLOAD_BYTES=2000000
MAX_DOCUMENT_BYTES=200000
MAX_REQUEST_BYTES=1000000
REQUESTS_PER_MINUTE=30
